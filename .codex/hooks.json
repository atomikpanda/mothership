{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mship _session-context --runtime codex",
            "statusMessage": "Loading Mothership context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mship _guard-edit --runtime codex",
            "statusMessage": "Checking Mothership edit policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mship _drain --runtime codex"
          }
        ]
      }
    ]
  }
}
